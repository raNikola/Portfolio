{
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && node scripts/build.js --env=development",
    "build": "npm run build:css && npm run build:html",
    "build:css": "sass --style=compressed --no-source-map assets/scss/main.scss assets/css/main.css",
    "build:html": "node scripts/build.js --env=production",
    "build:clean": "npm run build:css && node scripts/build.js --delete-dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  }
}
