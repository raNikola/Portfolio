{
  "type": "module",
  "scripts": {
    "dev": "npm run build:css:dev && node scripts/build.js --env=development",
    "build": "npm run build:css:prod && npm run build:html",
    "build:css": "npm run build:css:prod",
    "build:css:dev": "sass --style=compressed --embed-sources assets/scss/main.scss assets/css/main.css",
    "build:css:prod": "sass --style=compressed --no-source-map assets/scss/main.scss assets/css/main.css",
    "watch:css": "sass --watch --style=compressed --embed-sources assets/scss/main.scss assets/css/main.css",
    "build:html": "node scripts/build.js --env=production",
    "build:clean": "npm run build:css:prod && node scripts/build.js --env=production --delete-dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  }
}
